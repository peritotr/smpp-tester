# Web UI login password (at least 8 characters) — change it
UI_PASSWORD=change-me-to-a-strong-password

# Web UI port (change it if something else already uses 8080)
PORT=8080

# Address the web UI listens on:
#   127.0.0.1 → only from the server itself / through an SSH tunnel or a reverse proxy (recommended)
#   0.0.0.0   → directly reachable from the network
HOST=127.0.0.1

# Public IP shown in the UI as the vendor address (optional)
PUBLIC_IP=
